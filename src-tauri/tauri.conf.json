{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Versorium",
  "version": "0.1.0",
  "identifier": "dev.versorium.app",
  "build": {
    "beforeDevCommand": "./node_modules/.bin/vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./node_modules/.bin/vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Versorium",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5N0FDNjg3NDk5QUQzNDkKUldSSjA1cEpoOFo2T1Y4Y053TFNuQW1NbVRySTRCYnFhdTlVYXA5djd5b0RLL0UvTENEbmNsU2QK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
